# Managed by Ansible - eyebrowkang.litedump
[Unit]
Description=Litedump SQLite backup service
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/litedump.sh
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
PrivateDevices=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
{# ReadWritePaths must include each SOURCE db's directory too, not just the dest:
   SQLite writes -wal/-shm next to a WAL-mode source database, and ProtectSystem=strict
   makes the rest of the filesystem read-only (a WAL source would otherwise fail with
   "unable to open database file"). Dest dirs receive the backups. #}
{% set _rw_paths = (litedump_databases | map(attribute='dest') | list) + (litedump_databases | map(attribute='src') | map('dirname') | list) %}
{% set _rw_paths = _rw_paths | unique | list %}
{% if _rw_paths | length > 0 %}
ReadWritePaths={{ _rw_paths | join(' ') }}
{% endif %}

[Install]
WantedBy=multi-user.target
